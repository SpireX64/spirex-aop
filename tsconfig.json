{
    "compilerOptions": {
        "noEmit": true,
        "strict": true,
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["packages/*/src/**/*.ts"]
}
