{
    "name": "@spirex/aop",
    "version": "1.0.0",
    "description": "Lightweight aspect-oriented programming (AOP) library for JavaScript and TypeScript",
    "keywords": [
        "spirex",
        "aop",
        "aspect-oriented-programming",
        "aspect",
        "advice",
        "proxy",
        "interceptor",
        "annotations",
        "cross-cutting-concerns",
        "javascript",
        "typescript"
    ],
    "license": "MIT",
    "private": false,
    "sideEffects": false,
    "author": {
        "name": "Artem Sobolenkov (SpireX)",
        "email": "SpireX@outlook.com",
        "url": "https://github.com/SpireX64"
    },
    "homepage": "https://github.com/SpireX64/spirex-aop",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/SpireX64/spirex-aop.git"
    },
    "bugs": "https://github.com/SpireX64/spirex-aop/issues",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "default": "./dist/index.mjs"
            },
            "require": {
                "default": "./dist/index.cjs"
            },
            "default": {
                "default": "./dist/index.js"
            }
        },
        "./annotations": {
            "import": {
                "default": "./dist/annotations.mjs"
            },
            "require": {
                "default": "./dist/annotations.cjs"
            },
            "default": {
                "default": "./dist/annotations.js"
            }
        }
    },
    "scripts": {
        "prepack": "pnpm build:release && cp ../../README.md ./README.md && cp ../../LICENSE ./LICENSE",
        "test": "vitest run --config ./vitest.config.mjs",
        "test:c": "vitest run --config ./vitest.config.mjs --coverage",
        "build": "rollup --config --environment NODE_ENV:development",
        "build:release": "rollup --config --environment NODE_ENV:production",
        "clean": "rimraf dist coverage"
    }
}
